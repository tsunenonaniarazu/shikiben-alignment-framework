# ==============================================================================
# Shikiben (識扁) v2.4.0: Interactive Simulation & Visualizer
# Google Colab Ready - Interactive Trajectory & Real-time Phase Transition
# ==============================================================================

import numpy as np
import matplotlib.pyplot as plt
from ipywidgets import interact, FloatSlider

def run_shikiben_simulation(f_intent_x=1.5, f_intent_y=1.2, k_taidou=2.0, alpha_virtue=5.0):
    """
    Shikiben v2.4.0 の統合運動方程式をシミュレートし、インタラクティブに可視化します。
    """
    dt = 0.01
    steps = 600
    R_boundary = 2.0
    E_crit = 1.0
    gamma = 1.0
    
    # 初期条件
    f_intent = np.array([f_intent_x, f_intent_y])
    x = np.array([-1.0, 1.0])
    
    trajectory = [x.copy()]
    virtue_history = []
    ego_history = []
    
    # 運動方程式ループ
    for t in range(steps):
        r = np.linalg.norm(x)
        
        # 1. Ego (剛性・拘束度)
        E = np.exp(3.0 * (r - R_boundary)) if r > 0.5 else 0.0
        ego_history.append(E)
        
        # 2. 徳因子 λ (Virtue Factor) - シグモイド補間
        lambda_v = 1.0 / (1.0 + np.exp(alpha_virtue * (E - E_crit)))
        virtue_history.append(lambda_v)
        
        # 3. 大道 (Taidou) 引き戻し勾配
        g_taidou = -k_taidou * x
        
        # 4. 礼 (Rei) 二段階直交射影演算子
        if r >= R_boundary * 0.9:
            n = x / r
            P_rei = np.eye(2) - np.outer(n, n)
        else:
            P_rei = np.eye(2)
            
        # 5. 義 (Gi) 実行推進力
        f_gi = P_rei @ f_intent
        
        # 6. 識扁 v2.4.0 統合変調行列 M(x)
        M = lambda_v * P_rei + (1.0 - lambda_v) * np.eye(2)
        
        # 7. 状態更新
        dxdt = M @ (f_gi + gamma * g_taidou)
        x = x + dxdt * dt
        trajectory.append(x.copy())
        
    trajectory = np.array(trajectory)
    
    # ==========================================================================
    # プロット描画
    # ==========================================================================
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))
    
    # --- 左図：状態空間軌跡 (State Space Trajectory) ---
    circle = plt.Circle((0, 0), R_boundary, color='#E63946', fill=False, 
                        linestyle='--', linewidth=2.5, label='Safety Boundary ($\partial\Omega$)')
    ax1.add_patch(circle)
    
    # 軌跡
    ax1.plot(trajectory[:, 0], trajectory[:, 1], color='#1D3557', linewidth=2.5, label='Shikiben Trajectory')
    ax1.plot(trajectory[0, 0], trajectory[0, 1], 'go', markersize=9, label='Start Point')
    ax1.plot(0, 0, '*', color='#E9C46A', markersize=16, markeredgecolor='black', label='Taidou Center (0,0)')
    
    ax1.set_xlim(-2.5, 2.5)
    ax1.set_ylim(-2.5, 2.5)
    ax1.set_aspect('equal')
    ax1.grid(True, linestyle=':', alpha=0.6)
    ax1.set_title('State Trajectory: Tangential Sliding & Return', fontsize=12, fontweight='bold')
    ax1.set_xlabel('X State')
    ax1.set_ylabel('Y State')
    ax1.legend(loc='upper right', framealpha=0.9)
    
    # --- 右図：徳因子(λ)とEgo(E)の時系列推移 (Phase Transition) ---
    time_axis = np.arange(steps) * dt
    ax2.plot(time_axis, virtue_history, color='#2A9D8F', linewidth=2, label='Virtue Factor $\lambda(E)$ (Fluidity)')
    ax2.plot(time_axis, ego_history, color='#E63946', linewidth=1.5, linestyle=':', label='Ego Intensity $E$ (Rigidity)')
    
    ax2.set_ylim(-0.05, 1.1)
    ax2.grid(True, linestyle=':', alpha=0.6)
    ax2.set_title('Phase Transition Dynamics ($\lambda \leftrightarrow E$)', fontsize=12, fontweight='bold')
    ax2.set_xlabel('Time (s)')
    ax2.set_ylabel('Factor Value')
    ax2.legend(loc='upper right', framealpha=0.9)
    
    plt.tight_layout()
    plt.show()

# インタラクティブUIの表示
print("=== Shikiben v2.4.0 Interactive Colab Visualizer ===")
interact(
    run_shikiben_simulation,
    f_intent_x=FloatSlider(min=-3.0, max=3.0, step=0.1, value=1.5, description='Intent X:'),
    f_intent_y=FloatSlider(min=-3.0, max=3.0, step=0.1, value=1.2, description='Intent Y:'),
    k_taidou=FloatSlider(min=0.5, max=5.0, step=0.1, value=2.0, description='Taidou Pull:'),
    alpha_virtue=FloatSlider(min=1.0, max=10.0, step=0.5, value=5.0, description='Virtue Sens:')
);
